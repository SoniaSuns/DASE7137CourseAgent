# WhatsApp channel for the runnable smoke test:
# - cloud_api: Meta WhatsApp Cloud API sends the approval request and receives webhook replies.
# - whatsapp_web_automation: local Playwright + Chrome controls WhatsApp Web without an LLM agent.
# - codex_agent_web: Codex controls WhatsApp Web, detects staff tasks/replies, and reports evidence.
WHATSAPP_MODE=codex_agent_web
PORT=8787
LOCAL_BASE_URL=http://localhost:8787

# WhatsApp Cloud API test setup. Only needed when WHATSAPP_MODE=cloud_api.
WHATSAPP_ACCESS_TOKEN=replace_with_meta_temporary_or_system_user_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_test_phone_number_id
WHATSAPP_TO=852XXXXXXXX
WHATSAPP_VERIFY_TOKEN=choose_a_random_string_for_webhook_verification

# Codex agent + WhatsApp Web setup. Used when WHATSAPP_MODE=codex_agent_web.
CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
CODEX_MODEL=gpt-5.5
# Optional stage-specific models. Leave blank to use CODEX_MODEL.
CODEX_WHATSAPP_MODEL=
CODEX_MOODLE_MODEL=
CODEX_REVISION_MODEL=
# Optional model used by ./run_demo_flow.sh --fast when the stage-specific
# model variables above are not already exported in the shell.
CODEX_FAST_MODEL=
CODEX_AGENT_TIMEOUT=900
CODEX_REPLY_POLL_SECONDS=8
CODEX_REPLY_MAX_POLLS=18
CODEX_LISTENER_POLL_SECONDS=5
CODEX_MOODLE_LISTENER_POLL_SECONDS=5
CODEX_LISTENER_RESTART_DELAY=3
CODEX_MOODLE_LISTENER_RESTART_DELAY=3
CODEX_LISTENER_MAX_ATTEMPTS=2
CODEX_MOODLE_LISTENER_MAX_ATTEMPTS=2
# In free-task runtime mode the agent keeps running and accepts multiple staff
# prompts. Set to 0 only for one-shot smoke tests.
CODEX_LISTENER_FOREVER=1
CODEX_LISTENER_NEXT_RUN_DELAY=10
CODEX_WHATSAPP_APPROVAL_DRIVER=codex_agent
CODEX_FAST_MODE=0
CODEX_BROWSER_PROFILE=codex
CODEX_SANDBOX=danger-full-access
CODEX_DANGEROUSLY_BYPASS_APPROVALS_AND_SANDBOX=0
COURSE_AGENT_WHATSAPP_CHAT_NAME=test approval
COURSE_AGENT_APPROVAL_MESSAGE_FORMAT=boxed_ascii
COURSE_AGENT_APPROVER_NAME=WhatsApp Approver
COURSE_AGENT_NAME=codex
# Local reference pack for single-file refresh previews. This pack should
# contain only confirmed timeline/calendar/syllabus rules for the target course.
COURSE_AGENT_DEFAULT_COURSE_CODE=DASE7137
COURSE_AGENT_DEFAULT_SEMESTER=2026-2027-sem1
COURSE_REFERENCE_PACK_PATH=course_files/reference/DASE7137/2026-2027-sem1
# Optional read-only historical Moodle backups for planner evidence. Separate
# multiple absolute .mbz/extracted-backup paths with the platform path
# separator. The extractor exposes only sanitized metadata and safe course
# resource content; it excludes user/member, grade, feedback, and submission
# areas. Historical evidence never becomes an edit without planner selection.
# COURSE_AGENT_HISTORY_BACKUP_PATHS=/absolute/path/to/old-course.mbz
# Send a short WhatsApp notice when the long-running agent starts/stops.
COURSE_AGENT_LIFECYCLE_WHATSAPP_MESSAGES=1
# Browser windows are owned by the agent lifecycle. They should open/attach when
# the agent starts and close when the agent stops, not once per approval.
COURSE_AGENT_BROWSER_LIFECYCLE=agent
# 1 = Codex listens for a natural-language staff task before asking approval.
# 0 = compatibility mode for preconfigured approval smoke tests.
COURSE_AGENT_FREE_TASK_MODE=1
AGENT_REQUIRE_INCOMING_REPLY=1
# Production uses a dedicated WhatsApp account. Set to 1 only in an explicit
# single-account smoke test where the operator deliberately self-approves.
AGENT_SINGLE_ACCOUNT_TEST_MODE=0
REQUIRE_RUN_ID_IN_APPROVAL=1

# WhatsApp Web automation setup. Only needed when WHATSAPP_MODE=whatsapp_web_automation.
WHATSAPP_WEB_PROFILE_DIR=.whatsapp_web_profile
WHATSAPP_WEB_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
WHATSAPP_WEB_WAIT_SECONDS=420
# Deprecated and blocked: attachment approvals must be sent automatically by
# the browser driver. Positive values make the runner fail fast.
WHATSAPP_ATTACHMENT_MANUAL_SEND_SECONDS=0
WHATSAPP_AUTO_RESEND_ON_REVISE=1
WHATSAPP_AUTO_RESEND_MAX_ROUNDS=3

# Approval policy for the smoke test
BATCH_ID=SMOKE-MOODLE-WA-001
APPROVAL_THRESHOLD=1
# Optional comma-separated WhatsApp sender phone numbers. Leave empty for first test.
ALLOWED_WHATSAPP_NUMBERS=

# Moodle sandbox APIM target. Do not commit the real subscription key; export
# DASE7137_KEY in your shell or set it in your local untracked .env only.
MOODLE_API_URL=https://apidev.hku.hk/dase7137agent/
MOODLE_COURSE_URL=https://migrationtest-moodle.hku.hk/course/view.php?id=105330
MOODLE_COURSE_ID=105330
MOODLE_ANNOUNCEMENT_FORUM_ID=
MOODLE_SECTION_NAME=General
MOODLE_TEST_OBJECT_NAME=Announcements

# Default Moodle operation: publish one sandbox announcement through APIM after
# run-id-bound approval. Other supported API kinds: group_api, grouping_api,
# file_api_upload, course_file_resource_upload. access_time is represented but
# blocks until a custom Moodle plugin exists.
MOODLE_OPERATION_KIND=announcement_api
MOODLE_OPERATION_ID=SANDBOX-ANNOUNCEMENT-API
MOODLE_ANNOUNCEMENT_SUBJECT=[API TEST] Sandbox announcement RUN-TEMPLATE
MOODLE_ANNOUNCEMENT_BODY=<p>This is a sandbox-only Moodle API announcement test.</p>
MOODLE_APPROVAL_ATTACHMENT_PATHS=review_samples/sandbox_api_review_sample.md

# WhatsApp `OK <approval-code>` is the action-time Moodle write approval.
# Browser fallback writes run once after approval unless --precheck-only or
# dry-run/no-run flags are explicitly selected.
MOODLE_BROWSER_WRITE_POLICY=execute_only
MOODLE_AGENT_BROWSER_WRITE_POLICY=execute_only
MOODLE_BROWSER_PROFILE_DIR=.moodle_browser_profile
MOODLE_BROWSER_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
MOODLE_BROWSER_WAIT_SECONDS=300
# Optional automatic sandbox login. Keep real values only in the local,
# git-ignored .env file or the configured macOS Keychain entries.
MOODLE_LOGIN_USERNAME=
MOODLE_LOGIN_PASSWORD=

# API file upload test. This uploads to the Moodle file API area, defaulting to
# the token user's draft area. It does not create or replace a course File
# resource; that still requires a custom Moodle plugin.
# MOODLE_OPERATION_KIND=file_api_upload
# MOODLE_UPLOAD_FILE_PATH=test_upload_files/moodle_upload_demo_v2.txt
# MOODLE_EXPECTED_UPLOADED_FILENAME=moodle_upload_demo_v2.txt
# MOODLE_FILE_UPLOAD_CONTEXTLEVEL=user
# MOODLE_FILE_UPLOAD_COMPONENT=user
# MOODLE_FILE_UPLOAD_FILEAREA=draft
# MOODLE_FILE_UPLOAD_ITEMID=0
# MOODLE_FILE_UPLOAD_FILEPATH=/

# Course File resource upload. Requires the custom Moodle plugin in
# ../moodle_plugins/local_courseops_api to be installed on Moodle and exposed
# through APIM as local_courseops_api_upload_file_resource.
# MOODLE_OPERATION_KIND=course_file_resource_upload
# MOODLE_UPLOAD_FILE_PATH=test_upload_files/moodle_upload_demo_v2.txt
# MOODLE_EXPECTED_UPLOADED_FILENAME=moodle_upload_demo_v2.txt
# MOODLE_RESOURCE_NAME=TEST ONLY - API uploaded course file
# MOODLE_SECTION_NUM=0
# MOODLE_TARGET_MODULE_ID=0
# MOODLE_RESOURCE_VISIBLE=1

# Browser fallback for creating one visible course File resource in the
# migrationtest sandbox. Use only with MOODLE_EXECUTION_MODE=agent_browser_action
# and action-time approval.
# MOODLE_OPERATION_KIND=browser_course_file_resource_upload
# MOODLE_UPLOAD_FILE_PATH=test_upload_files/moodle_upload_demo_v2.txt
# MOODLE_EXPECTED_UPLOADED_FILENAME=moodle_upload_demo_v2.txt
# MOODLE_RESOURCE_NAME=TEST ONLY - browser uploaded course file
# MOODLE_SECTION_NAME=General
# MOODLE_SECTION_NUM=0
# MOODLE_RESOURCE_VISIBLE=1

# Course File resource replacement and access restriction edits are blocked by
# the API workflow until ITS installs a custom Moodle plugin exposing those web
# service functions. Replacement of an existing File resource can still use
# MOODLE_OPERATION_KIND=file_upload_replace with agent_browser_action when exact
# target module/settings details are known or safe target discovery is enabled.
# Optional: send the highlighted changed-region review version to the approver
# together with the WhatsApp approval request for upload/replace actions.
# MOODLE_HIGHLIGHTED_REVIEW_FILE_PATH=path/to/highlighted-review-file.pdf
# MOODLE_APPROVAL_ATTACHMENT_PATHS=path/to/extra-review-file.pdf

# Local multi-file review and ZIP safety limits. Values are bytes except file
# count and archive depth.
COURSE_REFRESH_BATCH_MAX_FILES=20
COURSE_REFRESH_BATCH_MAX_FILE_BYTES=104857600
COURSE_REFRESH_BATCH_MAX_TOTAL_BYTES=524288000
COURSE_REFRESH_BATCH_MAX_ARCHIVE_DEPTH=8

# Execution mode:
# - skip: test Codex/WhatsApp approval only; do not generate or open Moodle work.
# - agent_checklist: agent-owned approval generates a Moodle agent checklist; Moodle is not opened.
# - dry_run: no browser; just write operation package.
# - api_action: after approval, run the sandbox Moodle APIM operation.
# - agent_browser_action: explicit sandbox browser fallback, currently used for
#   course File resource upload while the Moodle plugin is not installed.
# - browser_action: legacy low-level script path.
MOODLE_EXECUTION_MODE=api_action
OPEN_BROWSER=0

# WhatsApp API version. Keep aligned with your Meta app if needed.
GRAPH_API_VERSION=v23.0
